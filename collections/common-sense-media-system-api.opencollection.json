{
  "opencollection": "1.0.0",
  "info": {
    "name": "Common Sense Media reviews system API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "system",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.commonsense.org/api/v3/system/ping"
          },
          "docs": "Simple status check confirming the API is reachable."
        }
      ]
    }
  ],
  "bundled": true
}